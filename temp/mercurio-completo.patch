From a709a7181c63a539be542dad7f1176fd742dec29 Mon Sep 17 00:00:00 2001
From: Mercurio <mercurio@example.com>
Date: Tue, 17 Nov 2026 23:17:35 +0000
Subject: [PATCH 2/2] Lite edition (arm64 only, light defaults) and edition
 choice in CI

---
 .github/workflows/build.yml                   | 37 +++++++++++++++++--
 README.md                                     |  4 ++
 app/build.gradle.kts                          | 20 +++++++++-
 .../bitchord/data/settings/AppSettings.kt     |  6 +--
 4 files changed, 58 insertions(+), 9 deletions(-)

diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index 8492688..915f163 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -8,6 +8,11 @@ on:
     branches: [main]
   workflow_dispatch:
     inputs:
+      edition:
+        description: 'Qué compilar: full (todos los teléfonos), lite (solo arm64, más ligero) o both'
+        type: choice
+        options: [full, lite, both]
+        default: full
       debug:
         description: 'Compilar también el APK de depuración (más rápido, sin firmar con tu llave)'
         type: boolean
@@ -80,19 +85,43 @@ jobs:
 
       # -Pbitchord.bundleWear=false: no empaqueta la app de Wear OS dentro del
       # APK (es más rápido y no la necesitamos por ahora).
-      - name: Build release APK
-        run: ./gradlew -Pbitchord.bundleWear=false :app:assembleProdRelease --stacktrace
+      - name: Build release APK (full)
+        if: ${{ (inputs.edition || 'full') != 'lite' }}
+        run: |
+          ./gradlew -Pbitchord.bundleWear=false :app:assembleProdRelease --stacktrace
+          mkdir -p dist/full
+          cp app/build/outputs/apk/prod/release/*.apk dist/full/
+
+      # Lite: un solo ABI (arm64-v8a) y valores por defecto ligeros.
+      # Paquete com.mercurio.app.lite, se instala junto a la versión full.
+      - name: Build release APK (lite)
+        if: ${{ (inputs.edition || 'full') != 'full' }}
+        run: |
+          ./gradlew -Pbitchord.bundleWear=false -Pmercurio.lite=true :app:assembleProdRelease --stacktrace
+          mkdir -p dist/lite
+          cp app/build/outputs/apk/prod/release/*arm64*.apk dist/lite/
 
       - name: Build debug APK (opcional)
         if: ${{ github.event_name == 'workflow_dispatch' && inputs.debug }}
         run: ./gradlew -Pbitchord.bundleWear=false :app:assembleProdDebug --stacktrace
 
       # Un APK ya viene comprimido: no gastamos tiempo en volver a comprimirlo.
-      - name: Upload release APK
+      - name: Upload APK full
+        if: ${{ (inputs.edition || 'full') != 'lite' }}
         uses: actions/upload-artifact@v4
         with:
           name: mercurio-apk
-          path: app/build/outputs/apk/prod/release/*.apk
+          path: dist/full/*.apk
+          if-no-files-found: error
+          compression-level: 0
+          retention-days: 30
+
+      - name: Upload APK lite
+        if: ${{ (inputs.edition || 'full') != 'full' }}
+        uses: actions/upload-artifact@v4
+        with:
+          name: mercurio-lite-apk
+          path: dist/lite/*.apk
           if-no-files-found: error
           compression-level: 0
           retention-days: 30
diff --git a/README.md b/README.md
index 8d77de4..9fea81d 100644
--- a/README.md
+++ b/README.md
@@ -54,6 +54,10 @@ Cómo está hecho (para añadir un estilo nuevo): `data/settings/ThemeStyle.kt`
 3. Al terminar (10-25 min), abre la ejecución y descarga **mercurio-apk** en *Artifacts*.
 4. Dentro del zip, el archivo `app-prod-universal-release.apk` funciona en cualquier teléfono.
 
+### Versión lite
+
+En **Actions → Build Mercurio APK → Run workflow** elige `lite` (o `both`) en *edition*. Descarga **mercurio-lite-apk**. Es solo arm64-v8a (casi todos los teléfonos de los últimos años), paquete `com.mercurio.app.lite` (se instala junto a la full) y arranca con desenfoque dinámico y animaciones reducidas y sin portadas animadas. En local: `./gradlew -Pmercurio.lite=true :app:assembleProdRelease`.
+
 ### Firma (opcional, recomendado)
 
 Sin configuración, cada build usa una llave temporal: el APK se instala, pero para instalar uno nuevo hay que desinstalar el anterior. Para poder **actualizar encima**, crea tu llave una vez y guárdala como *secrets* del repositorio (*Settings → Secrets and variables → Actions*):
